# --- Fournisseur du LLM : fake | openai | azure | anthropic | ollama ---
# "fake" = LLM factice à règles (démo / tests / CI), aucune clé nécessaire.
LLM_PROVIDER=fake
LLM_MODEL=
# mettre "none" si le modèle refuse ce paramètre
LLM_TEMPERATURE=0
# secondes par appel LLM
LLM_TIMEOUT=60

# --- Azure OpenAI (LLM_PROVIDER=azure) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=

# --- OpenAI (LLM_PROVIDER=openai) ---
OPENAI_API_KEY=

# --- Anthropic (LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=

# --- Embeddings pour le RAG : none | openai | azure | ollama ---
# "none" = recherche lexicale BM25 uniquement (déjà efficace sur un CV).
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_MODEL=

# --- Paramètres du pipeline ---
TOP_K=4
MAX_VERIFY_ROUNDS=2
MAX_JUDGE_RETRIES=2

# --- Instance publique (interface web / API) : garde-fous de coût ---
MAX_CV_CHARS=15000
MAX_OFFER_CHARS=8000
MAX_PDF_PAGES=5
# analyses par visiteur et par heure (0 = démo en pause)
RATE_LIMIT_PER_HOUR=5
# analyses par jour, tous visiteurs confondus
DAILY_ANALYSIS_CAP=100
# si défini, l'interface demande ce code avant d'analyser
# APP_ACCESS_CODE=
# si défini, l'API exige l'en-tête X-API-Key
# API_KEY=
# adresses du site web autorisées à appeler l'API (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000
# lien affiché dans l'interface
# GITHUB_URL=

# --- Observabilité (optionnel) : traces LangSmith ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=cvmatch
